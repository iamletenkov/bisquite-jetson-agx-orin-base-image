# AGX Orin + адаптер Sensing SG8A-AGON-G2Y-A1: база с камерами и cloud-init.
#
# ⚠️ СОБИРАЕТСЯ ТОЛЬКО НА arm64-ХОСТЕ: EXTENSION и INSTALL выполняют код
# в госте, а libguestfs чужую архитектуру не эмулирует.
#
# База — jetson-orin-base:36.4.3, изготовленная ВНЕ bisquite сценарием
# 08-build-base-image.sh (bisquite-extensions/extensions/debian/
# nvidia-jetpack/scripts/) и зарегистрированная `bs image import`: готового
# qcow2 у NVIDIA для L4T нет, его собирают из BSP плюс
# jetson-disk-image-creator.sh. Собирает его `make base` этого же
# репозитория; разбор по шагам — scripts/README.md.
#
# Этот VMFILE — тонкий слой между базой и прикладными профилями: камеры
# и cloud-init нужны ЛЮБОМУ роботу с этим адаптером, независимо от того,
# что сверху — десктоп с VNC или headless-инференс. FROM jetson-orin-camera
# годится для обоих случаев.
FROM jetson-orin-base:36.4.3 AS jetson-orin-camera:36.4.3

LABEL os=l4t
LABEL arch=arm64
LABEL version=r36.4.3
LABEL description="AGX Orin + Sensing GMSL2 (SG8A-AGON-G2Y-A1): база с камерами и аппаратным видеокодеком, без десктопа"
LABEL jetson.board=p3701-0000
LABEL jetson.carrier=p3737-0000
LABEL jetson.jetpack=6.2

# РАСШИРЕНИЕ ДИСКА — ПЕРВЫМ, ДО ЛЮБЫХ INSTALL/EXTENSION.
#
# Базовый образ намеренно компактный: 08-build-base-image.sh считает
# размер APP по факту содержимого rootfs (du -ms + 10% + 100 МБ), а не
# под финальный носитель — расширять его должен growpart на РЕАЛЬНОМ
# диске при записи. Но это значит, что у base ПОЧТИ НЕТ свободного места
# во время СБОРКИ: замер 2026-09-12 — APP 8007016 КБ, занято 7396956 КБ,
# свободно 181772 КБ (93%). Первая же попытка EXTENSION sensing-gmsl2-camera

# GStreamer с аппаратным кодеком — здесь, а не только в рабочей станции.
# Камера, с которой нечем сжать и отдать видео, — половина функции: без
# nvidia-l4t-gstreamer поток 1080p жмётся программным x264enc на CPU,
# а безголовый робот поверх этого слоя GNOME не ставит и убунтовского
# GStreamer не получил бы вовсе. RTSP-сервер, WebRTC (libnice) и
# python3-gst — туда же. Заголовки для разработки (GSTREAMER_DEV=1)
# добавляет рабочая станция: роботу в поле они не нужны.
EXTENSION l4t-gstreamer GSTREAMER_DEV=0
# упала на "No space left on device", даже с --depth 1 клоном пакета
# драйверов.
#
# RESIZE — не «код в госте» вовсе: раздел и файловую систему растягивают
# ИНСТРУМЕНТЫ APPLIANCE (part-resize, resize2fs через guestfish), гость
# при этом не загружается. Он в одном ряду с FROM/COPY_IN/UPLOAD — теми,
# что работают и при несовпадении архитектур хоста и образа (подробности —
# docs/guides/vmfile.md, «Управление диском»). root=PARTUUID, вписанный
# при сборке базы, не меняется: RESIZE растягивает раздел, а не
# пересоздаёт его.
#
# 40G — с запасом под самый тяжёлый нисходящий профиль
# (jetson-orin-workstation.vmfile: CUDA + TensorRT + GNOME + code-server),
# а не только под этот файл. qcow2 разреженный, поэтому
# запас ничего не стоит на диске хоста, пока не занят реальным содержимым.
# idx=1 — тот же номер, что у APP в разметке flash_l4t_t234_nvme.xml
# (физически последний на диске, но именно первая запись таблицы GPT).
RESIZE size=40G device=/dev/sda idx=1

# cloud-init: без него секция `cloud-init` манифеста записи не применится,
# причём МОЛЧА — раздел `cidata` создаётся всегда. В базовом образе L4T
# его нет (rootfs собран из sample rootfs NVIDIA, не облачного образа).
# nocloud-cidata переводит источник на метку `cidata`, которую пишет
# bs device write.
INSTALL cloud-init
EXTENSION nocloud-cidata

# Замена ядра, модули, DTB-оверлей, запись JetsonIO в загрузочном меню —
# разбор целиком в README самого расширения. root=PARTUUID, вписанный при
# сборке базового образа, этот слой не трогает.
EXTENSION sensing-gmsl2-camera

# ВЕНДОРСКАЯ СЛУЖБА НАСТРОЙКИ ЗАГРУЗЧИКА — ГЛУШИТСЯ. ОНА УБИВАЕТ ПЛАТУ.
#
# `nv-l4t-bootloader-config.service` (пакет nvidia-l4t-init) запускается
# при КАЖДОЙ загрузке и делает не то, что следует из названия: она не
# «настраивает», а ОБНОВЛЯЕТ И СИНХРОНИЗИРУЕТ ЗАГРУЗЧИК В QSPI, опираясь
# на версии пакетов внутри запущенной системы
# (`auto_update_bootloader`, «Check and sync up the two bootloader slots»
# в /opt/nvidia/l4t-bootloader-config/nv-l4t-bootloader-config.sh).
#
# Носитель она определяет по записи загрузки UEFI:
#
#     elif efibootdump "Boot${current_boot}" | grep -w "/USB" …
#         active_storage="sd."
#     else
#         echo "Error: Failed to find known boot media."
#
# Для образа, записанного бисквитом на внешний диск, запись выглядит не
# так, как она ждёт, — и дальше она работает с неверным представлением
# о носителе.
#
# ЧЕМ ЭТО КОНЧИЛОСЬ (2026-09-13, дважды за день). После загрузки с нашего
# SSD плата переставала грузиться ВООБЩЕ — чёрный экран, нет сети, не
# грузится даже с внутреннего NVMe при вынутом SSD. Восстанавливалась
# только перепрошивкой QSPI со станции
# (`l4t_initrd_flash.sh p3737-0000-p3701-0000-qspi internal`).
#
# ПОЧЕМУ ГЛУШИМ, А НЕ ЧИНИМ. Связь тут неверна по устройству: загрузчик
# в QSPI прошивается ОДИН РАЗ на модуль, кабелем, со станции — это
# отдельная операция и отдельная ответственность. Позволять корневой
# системе, растиражированной на флот, править прошивку модуля нельзя
# в принципе, даже если бы она определяла носитель верно.
#
# ПОЧЕМУ РУКАМИ, А НЕ `systemctl mask`. Юнит лежит в /etc/systemd/system —
# BSP кладёт его именно туда, а не в /lib. `systemctl mask` хочет создать
# на этом же пути симлинк на /dev/null, видит существующий файл и
# отказывает; сборка падает целиком (проверено 2026-09-13). Делаем то же
# самое явно: сносим зависимость из multi-user.target.wants и подменяем
# сам юнит ссылкой на /dev/null — это и есть маскирование, только без
# посредника, которому нужен живой systemd.
RUN_COMMAND rm -f /etc/systemd/system/multi-user.target.wants/nv-l4t-bootloader-config.service && ln -sf /dev/null /etc/systemd/system/nv-l4t-bootloader-config.service

# РЕЖИМ ПИТАНИЯ. Без него плата остаётся с НЕвыставленным режимом, и это
# ломает больше, чем кажется.
#
# Замер на живой плате 2026-09-12, первая загрузка с собранного образа:
# вендорская `nvpmodel.service` (она запускает ровно `nvpmodel -f
# /etc/nvpmodel.conf`) упала, `/var/lib/nvpmodel/status` не появился,
# `nvpmodel -q` отвечает «power mode is not set». Следом за ней в цикле
# перезапуска повис `jtop`: он читает текущий режим, получает None и
# падает с TypeError в nvpmodel.py. То есть одна невыставленная настройка
# уносит и мониторинг.
#
# ПОЧЕМУ ИМЕННО 0 (MAXN), А НЕ DEFAULT=2 ИЗ КОНФИГА ПЛАТЫ. Переход в режим
# 2 (30 Вт) меняет число онлайн-ядер и потому требует ПЕРЕЗАГРУЗКИ —
# nvpmodel спрашивает подтверждение, а на первой загрузке tty нет, и он
# отваливается с «bad input». Проверено обоими способами: `nvpmodel -m 2`
# даёт запрос и отказ, `nvpmodel -m 0` проходит молча и мгновенно, потому
# что все 12 ядер уже онлайн и менять нечего. После него jtop поднимается
# и создаёт /run/jtop.sock — проверено там же.
#
# Цена выбора: MAXN снимает ограничение мощности. Для машины с CUDA и
# TensorRT это обычно и нужно, но если робот на батарее — поставь 1 (15 Вт)
# или 3 (50 Вт) и учти, что переход, меняющий число ядер, потребует
# перезагрузки; тогда нужен `--force`, который перезагружает сам.
FIRSTBOOT_COMMAND "nvpmodel -m 0 || true"

# HOST-КЛЮЧИ SSH. Сборка безусловно гоняет virt-sysprep (операция
# ssh-hostkeys в наборе) — без regen на первой загрузке одинаковые ключи
# были бы на каждой прошитой плате, и sshd не поднимался бы вовсе
# (`no hostkeys available`).
FIRSTBOOT_COMMAND "ssh-keygen -A && systemctl restart ssh || true"
