# AGX Orin + Sensing GMSL2: робот с рабочим столом поверх jetson-orin-base.
#
# Собирается только на arm64. Первая загрузка не требует сети: расширения
# с фазой firstboot лишь доводят настройку до пользователя cloud-init.
# Добавляя слой, проверь его configure.sh на это свойство.
FROM jetson-orin-base:36.4.3

LABEL os=l4t
LABEL arch=arm64
LABEL version=r36.4.3
# Ветка загрузчика в QSPI платы: bs device write сверяет с boot-firmware манифеста.
LABEL boot.firmware=jetson-qspi:r36.4
LABEL description="AGX Orin + Sensing GMSL2: jetson-orin-base + GNOME, VNC, Selkies, code-server, Teleport, btop, Docker"
LABEL jetson.board=p3701-0000
LABEL jetson.carrier=p3737-0000
LABEL jetson.jetpack=6.2

EXTENSION btop

# GNOME (X11). cloud-user-desktop не нужен: в rootfs из BSP нет вендорской
# учётки, а группы и автологин на пользователя cloud-init делает сам gnome.
EXTENSION gnome

# x11vnc, а не vino: настройка — файл /etc/bisquite/x11vnc/config, его
# можно править из манифеста записи и на работающей машине; у vino — dconf
# пользователя. Слушает петлю: открывает наружу манифест записи, иначе
# туннелем: ssh -L 5900:127.0.0.1:5900 <пользователь>@<плата>
EXTENSION x11vnc X11VNC_LISTEN=localhost

# Без пароля, поэтому на петле: ssh -L 9002:127.0.0.1:9002 <пользователь>@<плата>
EXTENSION code-server \
    CODE_SERVER_PORT=9002 \
    CODE_SERVER_PASSWORD=none \
    CODE_SERVER_BIND=127.0.0.1

# После gnome: требует desktop-session. Путь — от каталога расширения.
EXTENSION wallpaper WALLPAPER_IMAGE=images/dst_1080.jpg

EXTENSION docker

# Тот же рабочий стол в браузере: https://127.0.0.1:6900, все функции, без пароля.
# На петле: снаружи — веб-приложение Teleport или ssh -L 6900:127.0.0.1:6900;
# на все интерфейсы открывает манифест записи. HTTPS — браузер даёт буфер,
# микрофон, камеру и геймпады только защищённому контексту; сертификат
# Selkies выпускает на устройстве. Звук — monitor PulseAudio пользователя.
# Нужен автологин (FIRSTBOOT_COMMAND ниже). +1.7 ГБ; кодирование аппаратное —
# его включает pixelflux-tegra строкой ниже.
EXTENSION selkies \
    SELKIES_ADDR=127.0.0.1 \
    SELKIES_PORT=6900 \
    SELKIES_ENABLE_HTTPS=true \
    SELKIES_MICROPHONE_ENABLED=true \
    SELKIES_WEBCAM_ENABLED=true \
    SELKIES_GAMEPAD_ENABLED=true \
    SELKIES_COMMAND_ENABLED=true \
    SELKIES_ENABLE_SHARING=true \
    SELKIES_SECOND_SCREEN=true \
    SELKIES_UI_SIDEBAR_SHOW_GAMEPADS=true \
    SELKIES_UI_SIDEBAR_SHOW_WEBCAM=true \
    SELKIES_UI_SIDEBAR_SHOW_SHARING=true \
    SELKIES_UI_SIDEBAR_SHOW_APPS=true

# Аппаратное кодирование H.264 для Selkies: подменяет pixelflux внутри его
# AppImage официальным колесом апстрима с бэкендом Tegra. 1080p@30 на живой
# сессии — 0.089 ядра против 0.423 на x264. Строка обязана идти ПОСЛЕ selkies:
# расширение правит поставленный тем AppImage (порядок строк bisquite не
# сортирует, поэтому при нарушении установка отказывает громко). +23 МБ.
EXTENSION pixelflux-tegra

# Teleport: SSH-нода и веб-приложения без входящих портов. Образ нейтрален
# к кластеру — адрес, env и токен задаёт `bisquite-teleport join` из манифеста
# записи. code-server объявлен в apps.d сам. Версия не новее кластера;
# зеркало стека: TELEPORT_MIRROR=https://binaries.<домен>.
EXTENSION teleport-agent TELEPORT_VERSION=18.6.8

# Браузер (Firefox) — в jetson-orin-base.

# Рабочий стол всегда на экране: вход без пароля, без автоблокировки
# и затемнения. Ручки bisquite-desktop, в расширении по умолчанию выключены.
FIRSTBOOT_COMMAND "bisquite-desktop set DESKTOP_AUTOLOGIN=1 DESKTOP_DISABLE_SCREEN_LOCK=1 DESKTOP_DISABLE_SCREEN_BLANK=1"

FIRSTBOOT_COMMAND "ssh-keygen -A && systemctl restart ssh || true"
