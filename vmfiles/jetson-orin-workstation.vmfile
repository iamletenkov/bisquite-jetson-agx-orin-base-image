# AGX Orin + Sensing GMSL2: полная рабочая станция для CV/инференса.
#
# ⚠️ СОБИРАЕТСЯ ТОЛЬКО НА arm64-ХОСТЕ (см. jetson-orin-camera.vmfile).
#
# Два дешёвых слоя поверх jetson-orin-camera: вся долгая работа (замена
# ядра под камеры, CUDA, TensorRT, десктоп) уже сделана ниже по цепочке,
# этот файл собирает их вместе и добавляет то, что специфично именно
# рабочей станции, а не любому роботу с этим адаптером.
#
# ⚠️ ПЕРВАЯ ЗАГРУЗКА НЕ ТРЕБУЕТ СЕТИ. Это свойство профиля, а не
# совпадение: расширения с фазой firstboot здесь только доводят настройку
# до пользователя cloud-init, ничего не скачивая. Единственное, что
# скачивало, — браузер; почему его тут нет, разобрано ниже по файлу.
# Добавляя слой, проверь его firstboot-скрипт — иначе свойство
# потеряется молча, и узнается это у робота в поле.
FROM jetson-orin-camera:36.4.3

LABEL os=l4t
LABEL arch=arm64
LABEL version=r36.4.3
LABEL description="AGX Orin + Sensing GMSL2: CUDA, TensorRT, GNOME, VNC, code-server, jtop, btop"
LABEL jetson.board=p3701-0000
LABEL jetson.carrier=p3737-0000
LABEL jetson.jetpack=6.2

# БАЗОВЫЙ ИНСТРУМЕНТАРИЙ. Тот же набор, что несёт образ станции прошивки
# (репозиторий bisquite, examples/build/amd64/ubuntu2204/) — чтобы на роботе под
# рукой было то же, к чему привык оператор на станции.
#
# Замер на прошитой плате 2026-09-12: базовый образ L4T не несёт ни nano,
# ни htop, ни mc, ни tree, ни dos2unix, ни cmake, ни dkms, ни apache2-utils.
# Это sample rootfs NVIDIA, а не облачный образ Ubuntu, и «обычные»
# утилиты там не подразумеваются.
#
# Здесь, а не в jetson-orin-camera.vmfile: слой камер остаётся тонким,
# и правка требует пересборки одного образа, а не двух. Понадобится тот же
# набор безголовому роботу — перенести строку ниже по цепочке.
#
# dkms, module-assistant и build-essential — не «на всякий случай»: сборка
# модулей ядра на месте это единственный путь, когда драйвер приходит
# исходниками, а кросс-компилировать под L4T негде.
RUN_COMMAND apt-get update
RUN_COMMAND apt-get install -y \
            sudo curl wget nano vim htop git \
            mc net-tools usbutils xz-utils tree \
            libcairo2-dev dos2unix bc module-assistant \
            pkg-config gcc build-essential \
            cmake make dkms ca-certificates g++ apache2-utils \
            libgl1 libnss3-tools

# CUDA и TensorRT — тяжёлые (десятки минут под эмуляцией, единицы гигабайт
# в образе), поэтому в отдельном слое поверх camera-базы, а не в ней самой:
# не каждому роботу с этими камерами нужен инференс на месте.
EXTENSION cuda-toolkit
EXTENSION tensorrt

# jtop — раньше CUDA/TensorRT, без разницы, но рядом с остальным мониторингом.
EXTENSION jetson-stats

EXTENSION btop

# GNOME + автологин под пользователем cloud-init — тот же выбор, что уже
# проверен на Jetson Nano (jetson-workstation-a02/-b00.vmfile): единственный
# десктоп-профиль с прецедентом на этой платформе в проекте.
EXTENSION gnome
EXTENSION cloud-user-desktop

# VNC — x11vnc, А НЕ vino, И ЭТО ВЫБОР ПО ЭКСПЛУАТАЦИИ, НЕ ПО ВКУСУ.
#
# Оба расширения дают одно и то же (`provides: [remote-desktop]`,
# `requires: [x11-server, display-manager]`) и взаимозаменяемы. Разница
# в том, как настройку менять на РАБОТАЮЩЕЙ машине, а роботу это нужно
# чаще, чем кажется.
#
#   x11vnc    /etc/default/bisquite-x11vnc + systemctl restart x11vnc@<юзер>
#   vino      dconf пользователя, файла-ручки нет вовсе
#
# У vino две ловушки, и обе проверены на живой плате 2026-09-12.
# Первая: /etc/default/bisquite-vino выглядит близнецом файла x11vnc, но
# ручкой не является — его читает configure.sh ОДИН раз на первой
# загрузке, и правка на работающей машине не даёт ничего. Вторая: в
# работающей сессии свой dconf-service, и запись мимо её шины (а именно
# так пишет firstboot, через dbus-run-session) он позже перетирает своим
# кешем — значение читается верным и тихо откатывается.
#
# X11 у профиля есть по построению (GNOME на Xorg, проверено:
# XDG_SESSION_TYPE=x11), так что ограничение x11vnc тут ничего не стоит.
#
# СЛУШАЕТ ПЕТЛЮ, И ЭТО УМОЛЧАНИЕ ОБРАЗА, А НЕ ОГРАНИЧЕНИЕ.
#
# Открытость наружу — свойство КОНКРЕТНОЙ машины, а не тиража: один робот
# стоит на стенде и его отлаживают, другой уехал в поле. Решение об этом
# принимается при ЗАПИСИ носителя, а не при сборке образа, поэтому здесь
# закрыто, а открывается из манифеста записи (device/, секция
# `firstboot-commands`):
#
#     sed -i 's/^X11VNC_LISTEN=.*/X11VNC_LISTEN=all/' /etc/default/bisquite-x11vnc
#
# Именно ради этого x11vnc и выбран вместо vino: у него настройка — файл,
# который правится одной строкой и читается службой при старте. У vino
# ручкой служит dconf пользователя, и из firstboot-команды манифеста туда
# не записать.
#
# Отладка без правки манифеста — туннелем, тогда трогать ничего не надо:
#     ssh -L 5900:127.0.0.1:5900 <пользователь>@<плата>
#
# Пароля нет: при петле он ничего не добавляет — кто уже на машине, тот
# и так там. Открываешь наружу — задавай X11VNC_PASSWORD, иначе к роботу
# подключится кто угодно из той же сети.
EXTENSION x11vnc X11VNC_LISTEN=localhost

# code-server на 127.0.0.1, без пароля — тот же довод: связка с
# PASSWORD=none и адресом 0.0.0.0 (умолчание расширения) означала бы
# шелл, открытый всей сети.
#     ssh -L 9002:127.0.0.1:9002 <пользователь>@<плата>
EXTENSION code-server CODE_SERVER_PORT=9002 CODE_SERVER_PASSWORD=none \
    CODE_SERVER_BIND=127.0.0.1

# Обои. Слой дешёвый и стоит после gnome не случайно: расширение
# объявляет `requires: [desktop-session]`, а даёт эту способность gnome —
# поставь выше, и резолвер откажет на сборке.
EXTENSION wallpaper

# БРАУЗЕРА ЗДЕСЬ НЕТ, И ЭТО РЕШЕНИЕ, А НЕ ПРОПУСК.
#
# `EXTENSION chromium` стоял здесь и был убран 2026-09-12. Причина —
# единственная в этом профиле зависимость первой загрузки ОТ СЕТИ:
# нативного Chromium для arm64 не существует ни в Ubuntu ports, ни
# в репозиториях NVIDIA (замер на живой плате — `chromium-browser` там
# транзитный пакет к снапу, `firefox` на jammy тоже), поэтому расширение
# доустанавливало снап на первой загрузке. У робота в поле сети может
# не быть, и тогда установка молча не доезжает.
#
# Остальные пять расширений с фазой firstboot сеть НЕ трогают — проверено
# по их configure.sh: они лишь доводят настройку до пользователя, которого
# на сборке не существовало (его создаёт cloud-init). То есть без этой
# строки образ полностью самодостаточен на первой загрузке.
#
# Если браузер на плате всё-таки понадобится, вариантов два, и оба
# ставятся на СБОРКЕ обычным apt: `epiphany-browser` (6 пакетов, движок
# WebKitGTK, родной для уже стоящего GNOME) или `falkon` (движок
# QtWebEngine, то есть Chromium внутри, с Chrome DevTools через
# --remote-debugging-port, но тянет 197 пакетов стека KDE поверх GNOME).
# Отлаживать веб-интерфейсы можно и с рабочей машины пробросом порта,
# не держа браузер на роботе:
#     ssh -L 9002:127.0.0.1:9002 <пользователь>@<плата>

FIRSTBOOT_COMMAND "ssh-keygen -A && systemctl restart ssh || true"
